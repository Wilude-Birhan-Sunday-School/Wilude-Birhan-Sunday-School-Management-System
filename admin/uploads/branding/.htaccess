# Super Admin uploaded branding assets (logo, seal, signatures, ID card background).
# Images are served publicly across the site and ID cards; script execution and
# directory listing are strictly denied.
Options -ExecCGI -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "(?i)\.(?:php[0-9]*|phtml|pht|phar|phps|cgi|pl|py|sh|shtml|svg|svgz|html?|xhtml|js|mjs|xml)(?:\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
